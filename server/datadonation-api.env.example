# Copy to `datadonation-api.env` and fill in real values for production.
# (The deploy script auto-creates datadonation-api.env with TEST defaults + a
#  random IP_SALT if it doesn't exist yet.)

# Cloudflare Turnstile SECRET key (server-side).
# The value below is Cloudflare's documented TEST secret — it makes EVERY token
# pass, so it is for testing only. Replace with your real secret before launch.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Optional hardening (recommended for production). Leave blank to disable.
# The widget sends action="donate"; require siteverify to echo it back:
TURNSTILE_ACTION=donate
# Only accept tokens issued on these hostnames (comma-separated):
TURNSTILE_HOSTNAMES=iemabot.surrey.ac.uk

# Salt for hashing client IPs (we store a salted hash, never the raw IP).
# Use a long random string; keep it stable so rate-limit history stays coherent.
IP_SALT=change-me-to-a-long-random-string

# Accept at most RATE_MAX submissions per IP per RATE_WINDOW seconds.
RATE_MAX=5
RATE_WINDOW=3600

# Max accepted request body size in bytes (default 25 MiB).
MAX_BYTES=26214400

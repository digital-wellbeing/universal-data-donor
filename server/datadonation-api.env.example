# Copy to `datadonation-api.env` and fill in real values for production.
# (The deploy script auto-creates datadonation-api.env with TEST defaults + a
#  random IP_SALT if it doesn't exist yet.)

# Cloudflare Turnstile SECRET key (server-side).
# The value below is Cloudflare's documented TEST secret — it makes EVERY token
# pass, so it is for testing only. Replace with your real secret before launch.
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Optional hardening (recommended for production). Leave blank to disable.
# The widget sends action="donate"; require siteverify to echo it back:
TURNSTILE_ACTION=donate
# Only accept tokens issued on these hostnames (comma-separated):
TURNSTILE_HOSTNAMES=iemabot.surrey.ac.uk

# Salt for hashing client IPs (we store a salted hash, never the raw IP).
# Use a long random string; keep it stable so rate-limit history stays coherent.
IP_SALT=change-me-to-a-long-random-string

# Accept at most RATE_MAX submissions per IP per RATE_WINDOW seconds.
# This only limits per CLIENT once the API can see real client IPs (XFF_TRUSTED_HOPS
# below + deploy/host/trust-gateway-xff.sh). Until then every participant shares the
# gateway's address and therefore ONE bucket: keep RATE_MAX high enough for the whole
# study in that case, and lower it (5-10) as soon as real client IPs are visible.
RATE_MAX=5
RATE_WINDOW=3600

# Accept plaintext donations (1, default) or refuse them (0). Turn this to 0 only once every
# platform has "encryptInBrowser": true in its config, so nothing can bypass browser-side
# encryption. Encrypted envelopes are always accepted.
ACCEPT_PLAINTEXT=1

# Refuse donations, and report unhealthy on GET /datadonation/submit, when the data
# volume has less than this much free space (counting twice the incoming body).
# Fails closed. MAX_DB_BYTES optionally caps the SQLite file itself (0 = no cap).
MIN_FREE_BYTES=2147483648
MAX_DB_BYTES=0

# Max accepted request body size in bytes (app default 25 MiB; 80 MiB here for
# Google Fit raw streams). Peak server RAM is ~12x the body per in-flight upload
# (parse + re-serialise + encrypt, measured: 79 MB peaked at ~1 GB, 95 MB at
# ~1.3 GB), so 80 MiB is ~1 GB per upload. Size this against the host's FREE RAM,
# not its total, and do not raise it without fixing or budgeting that multiplier.
# Only MAX_CONCURRENT_SUBMITS (default 1) uploads are processed at a time.
MAX_BYTES=83886080

# Trusted proxy hops in X-Forwarded-For (see app.py). 0 until Caddy trusted_proxies is set;
# 1 after `sudo bash deploy/host/trust-gateway-xff.sh` (the gateway is the one trusted hop).
XFF_TRUSTED_HOPS=0

# Public key for at-rest encryption of donations (private key stays offline).
# Generate: python donation_crypto.py keygen ./donation-private.key  (prints this value)
DONATION_PUBLIC_KEY=
REQUIRE_ENCRYPTION=0

# --- Storage backend -----------------------------------------------------------------------
# sqlite (default): donations live in a local file on the data volume.
# mysql: donations go to a MySQL server (schema: server/mysql_schema.sql, run once by a DB
# administrator). Only ciphertext is ever stored there, so this REQUIRES REQUIRE_ENCRYPTION=1
# and DONATION_PUBLIC_KEY, and the API refuses to start without them. Donations fail with
# 503 "storage_unavailable" (and /datadonation/submit reports unhealthy) while MySQL is down.
STORAGE_BACKEND=sqlite
#MYSQL_HOST=
#MYSQL_PORT=3306
#MYSQL_DATABASE=
#MYSQL_USER=datadonation
# Prefer a file (mounted read-only into the container) over putting the password here:
#MYSQL_PASSWORD_FILE=/run/secrets/datadonation_mysql_pw
#MYSQL_PASSWORD=
# required (default): encrypted, server certificate NOT verified. verify-ca / verify-full also
# verify the certificate (give MYSQL_CA_FILE if the server uses a private CA).
MYSQL_SSL_MODE=required
#MYSQL_CA_FILE=

